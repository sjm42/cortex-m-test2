#!/bin/bash
set -e
#set -x

usage()
{
	echo "Usage: $0 b|k|k401|n|r|d|s b|c|f|d|n"
	echo "  Hardware: b = Blue pill, k = Blackpill F411, k401 = Blackpill F401CC, n = Nucleo F411, r = nRf52840-dongle, d = nrf52840-Dk, s = nRf52840-dongle-s140"
	echo "  Operation: b = build, c = clippy, f = cargo flash, d = dfu flash, n = nrfdfu flash"
    echo "  Probe flash speed: PROBE_RS_SPEED in kHz (default: 100)"
    exit 1
}

case "$1" in
k401|K401)
    feat="black_pill_f401"
    tgt="thumbv7em-none-eabihf"
    chip="STM32F401CC"
    dfu_opt="-a 0 -s 0x8000000"
    ;;
K*|bla*|k*)
    feat="black_pill"
    tgt="thumbv7em-none-eabihf"
    chip="STM32F411CEUx"
    dfu_opt="-a 0 -s 0x8000000"
    ;;
B*|b*)
    feat="blue_pill"
    tgt="thumbv7m-none-eabi"
    chip="STM32F103C8"
    dfu_opt="-a 2 -s 0x8002000"
    ;;
N*|n*)
    feat="nucleo_f411"
    tgt="thumbv7em-none-eabihf"
    chip="STM32F411RETx"
    ;;
nR*|R*|r*)
    feat="nrf52840_dongle"
    tgt="thumbv7em-none-eabihf"
    chip="nRF52840_xxAA"
    ;;
D*|d*)
    feat="nrf52840_dk"
    tgt="thumbv7em-none-eabihf"
    chip="nRF52840_xxAA"
    ;;
s)
    feat="nrf52840_dongle_sd"
    tgt="thumbv7em-none-eabihf"
    chip="nRF52840_xxAA"
    ;;
*)
    usage
    ;;
esac

flags="--release --no-default-features --features $feat --target $tgt"
case "$2" in
B*|b*)
    set -x
    cargo build $flags
    ;;
C*|c*)
    set -x
    cargo clippy $flags
    ;;
F*|f*)
    set -x
    cargo flash $flags --chip "$chip" --protocol swd --speed "${PROBE_RS_SPEED:-100}"
    ;;
D*|d*)
    if [ $feat = nrf52840 ]
    then
      echo Use nrfdfu with nRF52840, not dfu.
      usage
    fi
    set -x
    cargo objcopy $flags -- -O binary target/out.bin
    set +x
    echo Boot the card in DFU mode and press Enter.
    read
    set -x
    dfu-util $dfu_opt -D target/out.bin
    ;;
N*|n*)
    set -x
    nrfdfu target/$tgt/release/cortex-m-test2
    ;;
*)
    usage
    ;;
esac
exit 0
# EOF
